{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arete",
  "version": "0.1.0",
  "identifier": "com.valerie.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Arete",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rob",
    "copyright": "© 2026 Arete",
    "category": "Productivity",
    "shortDescription": "Personal AI assistant dashboard",
    "longDescription": "Arete: gym, nutrition, looks and money in one system, with an AI coach that stays ahead of you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "Arete",
        "compression": "lzma",
        "installerHooks": "nsis-hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPO/main/releases/latest.json"
      ]
    }
  }
}
