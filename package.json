{
  "name": "valerie-temp",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "cross-env BUILD_TARGET=pwa vite build",
    "deploy:pwa": "cross-env BUILD_TARGET=pwa vite build && firebase deploy --only hosting",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "npm run tauri build -- --bundles nsis && powershell -ExecutionPolicy Bypass -File src-tauri/scripts/package-release.ps1",
    "package": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/package-release.ps1",
    "test": "cross-env TZ=Australia/Sydney vitest run",
    "test:watch": "cross-env TZ=Australia/Sydney vitest"
  },
  "dependencies": {
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "firebase": "^12.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
