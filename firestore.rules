// ─── Firestore Security Rules — VALERIE ───────────────────────────────────────
//
// Deploy with:  firebase deploy --only firestore:rules --project jarvis-14052
//
// Auth strategy: Firebase Anonymous Authentication required.
// The device ID is the Firestore path key (NOT the Firebase UID) — this keeps
// all existing user data intact across upgrades. Firebase Auth just provides
// the request.auth token so unauthenticated public access is blocked.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if
        // Must be signed in via Anonymous Auth — blocks all public access
        request.auth != null &&

        // Path key must be a non-trivial string
        userId != null &&
        userId.size() > 8 &&

        // Block writes of oversized payloads (max 50KB per document)
        (request.method == 'get' || request.method == 'list' ||
         request.resource.data.size() < 51200) &&

        // Block large string fields (XSS / injection guard)
        (!('title'       in request.resource.data) || request.resource.data.title.size()       < 2000) &&
        (!('content'     in request.resource.data) || request.resource.data.content.size()     < 10000) &&
        (!('description' in request.resource.data) || request.resource.data.description.size() < 2000) &&

        // Belt-and-suspenders: block secret key fields at DB level
        (!('apiKey'      in request.resource.data)) &&
        (!('finnhubKey'  in request.resource.data));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
