# Copy to .env and fill in. Never commit .env.
# Every VITE_ value is embedded in the shipped app: no secrets here.

# Your Supabase project (Dashboard > Project Settings > API). The anon key is public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Push reminders (optional): public half of the VAPID key pair. See docs/push-setup.md.
VITE_VAPID_PUBLIC_KEY=

# Error reporting (optional)
VITE_SENTRY_DSN=
